# ==============================================================================
# Gnani AI Student Tutor Agent - Environment Configuration Template
# Copy this file to '.env' and fill in your actual API credentials.
# NEVER commit or share your '.env' file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED API CREDENTIALS
# ------------------------------------------------------------------------------
# Gnani AI Platform API Key (powers Prisma STT and Timbre TTS)
# Obtain from: https://gnani.ai/
GNANI_API_KEY=your_gnani_api_key_here

# Google Gemini API Key (powers the pedagogical tutor reasoning)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. AUDIO HARDWARE SELECTION (OPTIONAL)
# ------------------------------------------------------------------------------
# Device index for audio input. If omitted or commented out, the system will
# automatically detect and select the best working default input device.
# Run 'python test_mic.py' to view available input device indices.
# MIC_DEVICE_INDEX=1

# ------------------------------------------------------------------------------
# 3. ADVANCED VAD & AUDIO RECOGNITION TUNING (OPTIONAL)
# Defaults are calibrated for typical Windows laptop microphones.
# ------------------------------------------------------------------------------
# RMS threshold below which input is treated as silence
# SILENCE_RMS_THRESHOLD=0.0025

# Energy threshold for speech onset (adaptive calibration adjusts automatically)
# VAD_ENERGY_THRESHOLD=0.010

# Safe lower and upper bounds for adaptive VAD threshold
# SAFE_MIN_VAD_THRESHOLD=0.005
# SAFE_MAX_VAD_THRESHOLD=0.025

# Hysteresis ratio for speech continuation (continuation threshold = onset * ratio)
# VAD_CONTINUATION_RATIO=0.55

# Hangover chunks (300ms) across intra-word consonant dips
# VAD_HANGOVER_CHUNKS=6

# Continuous silence after speech required to stop recording (in seconds)
# SILENCE_TIMEOUT_SECONDS=1.1

# Maximum single recording duration for doubts/questions (in seconds)
# MAX_RECORD_DURATION=30.0

# Timeout waiting for student to begin speaking (in seconds)
# INITIAL_SILENCE_TIMEOUT=6.0

# Audio pre-roll buffer to prevent clipping beginning of speech (in seconds)
# PRE_ROLL_SECONDS=0.4

# Minimum speech duration to qualify as spoken input (in seconds)
# MIN_SPEECH_DURATION=0.3

# Settling pause to prevent echo from previous playback (in seconds)
# SETTLING_PAUSE_SECONDS=0.25

# Safety timeout for student quiz responses (in seconds)
# QUIZ_ANSWER_TIMEOUT_SECONDS=120.0

# Natural pause duration to trigger interim stop check during quizzes (in seconds)
# QUIZ_PAUSE_CHECK_SECONDS=1.2
